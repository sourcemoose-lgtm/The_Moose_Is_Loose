from PySide6.QtWidgets import (
    QApplication,
    QWidget,
    QVBoxLayout,
    QPushButton,
    QLabel
)

import sys

#==============================================
# KART - MENU
#==============================================


class KartMenu(QWidget):

    def __init__(self, character):
        super().__init__()

        self.selected_character = character

        self.setWindowTitle("CHOOSE YOUR KART!")
        self.resize(1320, 900)

        layout = QVBoxLayout()

        title = QLabel("KART MENU")

        self.firstkart_button = QPushButton("Demon Kart")
        self.secondkart_button = QPushButton("Second Kart")
        self.thirdkart_button = QPushButton("Third Kart")
        self.fourthkart_button = QPushButton("Fourth Kart")

        layout.addWidget(title)
        layout.addWidget(self.firstkart_button)
        layout.addWidget(self.secondkart_button)
        layout.addWidget(self.thirdkart_button)
        layout.addWidget(self.fourthkart_button)

        self.setLayout(layout)

        self.firstkart_button.clicked.connect(self.kart_selected)

    def kart_selected(self):
        self.selected_kart = "Demon Kart"

        print("Character:", self.selected_character)
        print("Kart:", self.selected_kart)

